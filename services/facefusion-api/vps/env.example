# Yuz xizmatining VPS'dagi sozlamalari. Serverda `.env` nomi bilan turadi
# (`up.sh` birinchi marta shu fayldan nusxa oladi; deploy unga tegmaydi).

# Xizmat tashqariga shu nom bilan chiqadi. DNS'da A yozuv shu serverga
# qarashi shart — sertifikat shunga beriladi.
FACE_DOMAIN="face.looksave.uz"

# Xizmatni chaqira oladigan manzillar, bo'sh joy bilan ajratiladi.
#   127.0.0.1     — serverning o'zidan sinash uchun
#   189.74.98.75  — jonli API serveri (api.looksave.uz)
# API boshqa serverga ko'chsa, yangi manzilni shu yerga qo'shing va
# `./up.sh --public` ni qayta yurgizing.
API_ALLOW_IPS="127.0.0.1 189.74.98.75"

# Bir vaqtda nechta so'rov qabul qilinadi: bittasi ishlaydi, qolgani navbatda
# kutadi, ortig'i darhol 503 oladi (API keyinroq o'zi qayta urinadi). Qoida:
# (shu son × bitta rasm vaqti, ~30 s) API'ning kutish vaqtidan (240 s) oshmasin.
FACE_MAX_PARALLEL="6"

# Yuz almashtirish. off — xizmat rasmga faqat kesim qiladi: orqa fon olinadi,
# qolgan hamma piksel (yuz ham) AI qanday chizgan bo'lsa shunday qoladi;
# bitta rasm ~10 soniya. on — AI natijasiga mijozning ASL yuzi qo'yiladi
# (~28 soniya, xotira ~17 GB). 2026-11-15: loyiha egasi «off» ni tanladi.
# O'zgartirgach: `./up.sh`.
FACE_SWAP="off"

# Ixtiyoriy qo'shimcha himoya: qo'yilsa har so'rovda
# `Authorization: Bearer <shu qiymat>` kerak bo'ladi (API'da FACEFUSION_TOKEN).
FACEFUSION_API_TOKEN=""

# FACE_MEM_LIMIT — konteyner xotira chegarasi (24 GB gacha).
# FACE_CPUSET    — xizmatga beriladigan yadrolar, masalan "0-7" (8 ta).
# Ikkalasini `up.sh` serverga qarab o'zi hisoblaydi va shu faylning oxiriga
# qo'shadi. Qo'lda o'zgartirsangiz: `./up.sh` ni qayta yurgizing.
