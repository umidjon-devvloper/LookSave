# Dependencies
node_modules/
.npm/
.pnp.*

# Build artefaktlari
dist/
build/
.output/
*.tsbuildinfo

# Environment — hech qachon commit qilinmaydi
.env
.env.*
!.env.example

# Loglar
*.log
npm-debug.log*
logs/

# Expo / React Native
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/

# Xcode — foydalanuvchiga xos holat (D-38).
# Bu fayllar oyna joylashuvi va ochiq tablarni saqlaydi: har mashinada
# boshqacha va har ochilishda o'zgaradi. Ilgari `umidjon/` shablon
# loyihasi bilan birga repoga tushib qolgan edi.
**/xcuserdata/
*.xcuserstate
DerivedData/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Vite / web panellar
apps/*/dist/
.vite/

# Test va coverage
coverage/
.nyc_output/

# IDE va OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Cache
.eslintcache
.cache/
.turbo/

# 3D ish fayllari (manba .blend git-lfs orqali, backup fayllar yo'q)
*.blend1
*.blend2
assets-3d/**/tmp/

# Ma'lumotlar bazasi dump/backup
*.dump
*.sql.gz
backups/

# Infra — volume ma`lumotlari va sirlar
infra/data/
infra/.env

# API lokal muhit
apps/api/.env

# Python (blender_scripts)
__pycache__/
*.pyc

# Generatsiya natijasi — `assets-3d/export` dan avtomatik ko`chiriladi.
# Manba bitta: `assets-3d/export`. Nusxalarni commit qilish har model
# o`zgarishida ~8 MB binar diff beradi va tarixni bekorga shishiradi.
#   sayt:  apps/web/scripts/sync-models.mjs      (predev / prebuild)
#   mobil: apps/mobile/scripts/sync-models.mjs   (prestart / preios)
apps/web/public/models/
apps/mobile/assets/models/

# React Router yasaydigan marshrut tiplari
.react-router/

# MediaPipe modeli — `@vladmandic/human` ga o'tilgandan keyin ishlatilmaydi,
# lekin 3.6 MB. Kerak bo'lsa qaytadan yuklab olinadi, gitda saqlanmaydi.
assets-3d/generator/models/
