# LookSave API — lokal ishlab chiqish uchun muhit o'zgaruvchilari namunasi.
# To'liq ro'yxat va tekshiruv qoidalari: src/config/env.ts
# Production (Docker) uchun: infra/.env.example
#
#   cp .env.example .env
#
# ⚠️ `.env` git'ga TUSHMAYDI. Bu fayl faqat namuna.
# Yetishmayotgan yoki noto'g'ri qiymat bo'lsa server ishga tushmaydi —
# xatoni darhol konsolda ko'rasiz.

# ── Umumiy ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug          # fatal | error | warn | info | debug | trace | silent
API_TAG=dev              # deploy qilingan versiya (git sha); lokalda "dev"

# ── Baza va Redis (MAJBURIY) ──
# infra/docker-compose.dev.yml ko'targan konteynerlar uchun standart qiymatlar
DATABASE_URL=postgres://looksave:looksave@localhost:5432/looksave
REDIS_URL=redis://localhost:6379

# ── JWT (MAJBURIY) ──
# Kamida 32 belgi, access va refresh ALOHIDA bo'lishi shart (bir xil bo'lsa
# server ko'tarilmaydi). Real sir: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-000000000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-11111111111111111111111
JWT_ACCESS_TTL=15m       # format: <son><s|m|h|d>
JWT_REFRESH_TTL=30d

# ── HTTP ──
# Vergul bilan ajratiladi. Bo'sh bo'lsa CORS umuman yopiq.
# 5173 — store-panel, 5174 — admin-panel
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BODY_LIMIT=12mb          # Caddy'da ham shu chegara (docs/08-deployment.md §5)

# ── SSR sayti uchun xizmat kaliti (15-sayt-dizayn.md S-4) ──
#
# Sayt server tomonda chizilgani uchun API ga so'rov MEHMONDAN emas,
# VEB-SERVERDAN keladi. Kalitsiz butun sayt daqiqasiga 30 ta so'rovlik
# bitta chelakni bo'lishadi va sahifalar bo'sh ochiladi.
#
# Bu kalit bilan tanishtirgan chaqiruvchi mehmon IP'sini
# `X-LookSave-Client-Ip` sarlavhasida bera oladi.
#
# ⚠️ SERVER-SERVER. Brauzer bundle'iga TUSHMASIN — aks holda har kim
# o'z cheklovini o'chirib qo'yadi. `apps/web` da xuddi shu qiymat
# `INTERNAL_SERVICE_KEY` nomi bilan turadi.
#
# ⚠️ Bo'sh bo'lsa imkoniyat o'chiq — hech narsa buzilmaydi, cheklov
# eskicha `req.ip` bo'yicha ishlaydi.
#
#   openssl rand -base64 32
INTERNAL_SERVICE_KEY=

# ── Biznes qoidalari ──
ORDER_EXPIRY_HOURS=24       # 1..168
MAX_OPEN_ORDERS=3           # 1..50
MAX_DAILY_ORDERS=5          # 1..100
DEFAULT_COMMISSION_RATE=0   # 0..0.5 — Faza 1-2 da 0 (K-12)

# ── Telegram (ixtiyoriy) ──
# Token bo'sh bo'lsa bot o'chirilgan deb hisoblanadi — lokalda shunday qoldiring.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # openssl rand -hex 32
TELEGRAM_BOT_USERNAME=LookSaveBot
STORE_PANEL_URL=http://localhost:5173   # to'liq URL bo'lishi shart

# ── Push (ixtiyoriy) ──
# Bo'sh bo'lsa push o'chirilgan deb hisoblanadi.
EXPO_ACCESS_TOKEN=

# ── 3D avatar ──
# Skelet versiyasi model havolalariga kiradi — yangilanganda ilovani qayta
# chiqarish shart emas, faqat bu qiymat o'zgaradi.
AVATAR_SKELETON_VERSION=v1

# ── Cloudflare R2 (ixtiyoriy; bo'sh bo'lsa yuklash ishlamaydi) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                 # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_ASSETS=looksave-assets

# Yuz va gavda suratlari uchun ALOHIDA, ommaviy bo'lmagan bucket (D-43).
#
# ⚠️ `Cache-Control: private` YETMAYDI. R2_BUCKET_ASSETS ning r2.dev manzili
# ochiq — havolani bilgan har kim suratni kalitsiz ocha oladi. Yagona
# ishonchli chegara — boshqa bucket, public access OFF.
#
# Bo'sh bo'lsa hammasi eskicha R2_BUCKET_ASSETS ga boradi va ilova
# ishlayveradi — lekin yuz suratlari OCHIQ qoladi. API ishga tushishda
# buni ogohlantirib aytadi.
#
# Sozlagandan keyin tekshiring:
#   npm run check:private-bucket --workspace=apps/api
R2_BUCKET_PRIVATE=

CDN_BASE_URL=https://cdn.looksave.app   # to'liq URL bo'lishi shart

# ── AI kiyintirish provayderi (OpenAI) ──
# Kalitsiz AI kiyintirish butunlay o'chiq bo'ladi va ilova buni ochiq
# aytadi — kalitsiz so'rov yuborib 401 kutish emas.
OPENAI_API_KEY=

# Rasm modeli. Bo'sh qoldirilsa `gpt-image-2.5-sunburst` ishlatiladi:
# tahrir aniqligiga yo'naltirilgan, kirish rasmlarini har doim yuqori
# aniqlikda qayta ishlaydi (yuz va logo shunda saqlanadi) va chiqishi
# arzonroq — 1M tokeniga $30.
#
# ⚠️ ALMASHTIRISHDAN OLDIN: `gpt-image-1` va `1.5` kirishni sukut
# bo'yicha PAST aniqlikda oladi va ularga `input_fidelity=high` alohida
# yuboriladi (`integrations/openai.ts` — `buildImageOptions`). Bu kod
# tomonidan hal qilinadi, lekin har chaqiruvga ~6144 token qo'shadi.
#
# ⚠️ BU MODEL UMUMIY RASM GENERATORI, try-on uchun maxsus o'qitilmagan:
# kiyimni nusxa ko'chirmaydi, «shunga o'xshash» qilib chizadi.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Chiqish sifati — ENG KATTA SIFAT RICHAGI. Pog'onalar: low < medium <
# high < xhigh < max. Yuqoriroq = matoni, chokni, naqshni va yuzni aniqroq
# chizadi (try-on sifatini ko'taradi), lekin har chaqiruvda chiqish tokeni
# (pul) oshadi. Bo'sh qoldirilsa `high`.
#
# ⚠️ `xhigh`/`max` faqat 2.5 oilasida; `gpt-image-1` ga ular 400 beradi.
# O'zgartirilsa eski kesh avtomatik yangilanadi (retseptga kiradi), ya'ni
# natijalar yangi sifatda qaytadan yasaladi — redeploy shart emas.
# OPENAI_IMAGE_QUALITY=high

# ── developer_ai paneli (operator navbati) ──
# Qaysi AI ishlari operatorga ketadi: avatar, render (vergul bilan).
# Bo'sh — hammasi avvalgidek to'g'ridan-to'g'ri OpenAI ga.
DEVELOPER_AI_KINDS=
# AI majburan OpenAI orqali ishlaydigan userlar (UUID, vergul bilan).
# Operator rejimi yoniq bo'lsa ham bu akkauntlar darhol natija oladi.
# Masalan App Store demo akkaunti. Bo'sh — hech kimga istisno yo'q.
DEVELOPER_AI_AUTO_USERS=
# Operatorlar guruhi (bo'sh — Telegram xabari yuborilmaydi)
DEVELOPER_AI_TELEGRAM_CHAT_ID=
DEVELOPER_AI_PANEL_URL=https://ai.looksave.app

# ── Yuz almashtirish (services/facefusion-api) ──
# AI natijasiga mijozning ASL yuzini joylaydi va fonni olib tashlaydi.
# ⚠️ Bo'sh bo'lsa butunlay O'CHIQ: natija AI chizgan yuz bilan ketadi va
# buni hech narsa ogohlantirmaydi (logda faqat `face: disabled`).
# Jonli: https://face.looksave.uz — o'z VPS'imiz (2026-11-15 gacha
# https://facefusion.fly.dev edi). Xizmat faqat ruxsat berilgan manzildan
# chaqirilganda javob beradi: services/facefusion-api/vps/env.example.
# ⚠️ VPS'da yuz almashtirish O'CHIRILGAN (u yerda `FACE_SWAP="off"`,
# 2026-11-15): shu manzil ulansa natijaga faqat kesim qilinadi va yuz AI
# chizganidek qoladi. Pastdagi MODEL / PIXEL_BOOST / ENHANCE unda ta'sirsiz.
FACEFUSION_URL=
# Xizmatda `FACEFUSION_API_TOKEN` qo'yilgan bo'lsa — o'sha qiymat
FACEFUSION_TOKEN=
# FACEFUSION_MODEL=inswapper_128
# FACEFUSION_PIXEL_BOOST=512x512
# FACEFUSION_ENHANCE=true
# FACEFUSION_FRONT_ONLY=true
