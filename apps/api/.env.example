# LookSave API — lokal ishlab chiqish uchun muhit o'zgaruvchilari namunasi.
# To'liq ro'yxat va tekshiruv qoidalari: src/config/env.ts
# Production (Docker) uchun: infra/.env.example
#
#   cp .env.example .env
#
# ⚠️ `.env` git'ga TUSHMAYDI. Bu fayl faqat namuna.
# Yetishmayotgan yoki noto'g'ri qiymat bo'lsa server ishga tushmaydi —
# xatoni darhol konsolda ko'rasiz.

# ── Umumiy ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug          # fatal | error | warn | info | debug | trace | silent
API_TAG=dev              # deploy qilingan versiya (git sha); lokalda "dev"

# ── Baza va Redis (MAJBURIY) ──
# infra/docker-compose.dev.yml ko'targan konteynerlar uchun standart qiymatlar
# Lokal PostGIS (Postgres.app 16 + PostGIS 3.4) — production bilan bir xil versiya.
DATABASE_URL=postgres://looksave:looksave@localhost:5432/looksave
# ⚠️ Quyidagi Railway bazasi BOSHQA loyihaniki (Prisma: Client/Project/Task...)
# va PostGIS'siz. LookSave migratsiyalari u yerda ishlamaydi — ishlatmang.
# DATABASE_URL=postgresql://postgres:BQmbcbLOawoUTYyqRzLjukHYlvflxkCF@altaria.proxy.rlwy.net:26672/railway
REDIS_URL=redis://default:kpKtCqbnFBALHEATZfCdsSLcoZVXltAn@altaria.proxy.rlwy.net:53611

# ── JWT (MAJBURIY) ──
# Kamida 32 belgi, access va refresh ALOHIDA bo'lishi shart (bir xil bo'lsa
# server ko'tarilmaydi). Real sir: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-000000000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-11111111111111111111111
JWT_ACCESS_TTL=15m       # format: <son><s|m|h|d>
JWT_REFRESH_TTL=30d

# ── HTTP ──
# Vergul bilan ajratiladi. Bo'sh bo'lsa CORS umuman yopiq.
# 5173 — store-panel, 5174 — admin-panel
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BODY_LIMIT=12mb          # Caddy'da ham shu chegara (docs/08-deployment.md §5)

# ── Biznes qoidalari ──
ORDER_EXPIRY_HOURS=24       # 1..168
MAX_OPEN_ORDERS=3           # 1..50
MAX_DAILY_ORDERS=5          # 1..100
DEFAULT_COMMISSION_RATE=0   # 0..0.5 — Faza 1-2 da 0 (K-12)

# ── Telegram (ixtiyoriy) ──
# Token bo'sh bo'lsa bot o'chirilgan deb hisoblanadi — lokalda shunday qoldiring.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # openssl rand -hex 32
TELEGRAM_BOT_USERNAME=LookSaveBot
STORE_PANEL_URL=http://localhost:5173   # to'liq URL bo'lishi shart

# ── Push (ixtiyoriy) ──
# Bo'sh bo'lsa push o'chirilgan deb hisoblanadi.
EXPO_ACCESS_TOKEN=

# ── 3D avatar ──
# Skelet versiyasi model havolalariga kiradi — yangilanganda ilovani qayta
# chiqarish shart emas, faqat bu qiymat o'zgaradi.
AVATAR_SKELETON_VERSION=v1

# ── Cloudflare R2 (ixtiyoriy; bo'sh bo'lsa yuklash ishlamaydi) ──
R2_ACCESS_KEY_ID=5e7edb9c99e6648312c1747eddff3f59
R2_SECRET_ACCESS_KEY=0e6e571bc7b7e75e74f3d7416e1213f61f517d11be3f3b1e64fc19a1af51f82c
R2_ENDPOINT=https://40c7e90c6c42becf6747ceccd482b00a.r2.cloudflarestorage.com
R2_BUCKET_ASSETS=looksave-assets
# R2 ning bepul ommaviy havolasi. Domen olingach → https://cdn.looksave.app
# (Cloudflare: R2 → Settings → Custom Domains) va faqat shu qator o'zgaradi.
CDN_BASE_URL=https://pub-24eaa9d31e324e0aadf692d761e8dc54.r2.dev
