# LookSave API — lokal ishlab chiqish uchun muhit o'zgaruvchilari namunasi.
# To'liq ro'yxat va tekshiruv qoidalari: src/config/env.ts
# Production (Docker) uchun: infra/.env.example
#
#   cp .env.example .env
#
# ⚠️ `.env` git'ga TUSHMAYDI. Bu fayl faqat namuna.
# Yetishmayotgan yoki noto'g'ri qiymat bo'lsa server ishga tushmaydi —
# xatoni darhol konsolda ko'rasiz.

# ── Umumiy ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug          # fatal | error | warn | info | debug | trace | silent
API_TAG=dev              # deploy qilingan versiya (git sha); lokalda "dev"

# ── Baza va Redis (MAJBURIY) ──
# infra/docker-compose.dev.yml ko'targan konteynerlar uchun standart qiymatlar
DATABASE_URL=postgres://looksave:looksave@localhost:5432/looksave
REDIS_URL=redis://localhost:6379

# ── JWT (MAJBURIY) ──
# Kamida 32 belgi, access va refresh ALOHIDA bo'lishi shart (bir xil bo'lsa
# server ko'tarilmaydi). Real sir: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-000000000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-11111111111111111111111
JWT_ACCESS_TTL=15m       # format: <son><s|m|h|d>
JWT_REFRESH_TTL=30d

# ── HTTP ──
# Vergul bilan ajratiladi. Bo'sh bo'lsa CORS umuman yopiq.
# 5173 — store-panel, 5174 — admin-panel
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
BODY_LIMIT=12mb          # Caddy'da ham shu chegara (docs/08-deployment.md §5)

# ── SSR sayti uchun xizmat kaliti (15-sayt-dizayn.md S-4) ──
#
# Sayt server tomonda chizilgani uchun API ga so'rov MEHMONDAN emas,
# VEB-SERVERDAN keladi. Kalitsiz butun sayt daqiqasiga 30 ta so'rovlik
# bitta chelakni bo'lishadi va sahifalar bo'sh ochiladi.
#
# Bu kalit bilan tanishtirgan chaqiruvchi mehmon IP'sini
# `X-LookSave-Client-Ip` sarlavhasida bera oladi.
#
# ⚠️ SERVER-SERVER. Brauzer bundle'iga TUSHMASIN — aks holda har kim
# o'z cheklovini o'chirib qo'yadi. `apps/web` da xuddi shu qiymat
# `INTERNAL_SERVICE_KEY` nomi bilan turadi.
#
# ⚠️ Bo'sh bo'lsa imkoniyat o'chiq — hech narsa buzilmaydi, cheklov
# eskicha `req.ip` bo'yicha ishlaydi.
#
#   openssl rand -base64 32
INTERNAL_SERVICE_KEY=

# ── Biznes qoidalari ──
ORDER_EXPIRY_HOURS=24       # 1..168
MAX_OPEN_ORDERS=3           # 1..50
MAX_DAILY_ORDERS=5          # 1..100
DEFAULT_COMMISSION_RATE=0   # 0..0.5 — Faza 1-2 da 0 (K-12)

# ── Telegram (ixtiyoriy) ──
# Token bo'sh bo'lsa bot o'chirilgan deb hisoblanadi — lokalda shunday qoldiring.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # openssl rand -hex 32
TELEGRAM_BOT_USERNAME=LookSaveBot
STORE_PANEL_URL=http://localhost:5173   # to'liq URL bo'lishi shart

# ── Push (ixtiyoriy) ──
# Bo'sh bo'lsa push o'chirilgan deb hisoblanadi.
EXPO_ACCESS_TOKEN=

# ── 3D avatar ──
# Skelet versiyasi model havolalariga kiradi — yangilanganda ilovani qayta
# chiqarish shart emas, faqat bu qiymat o'zgaradi.
AVATAR_SKELETON_VERSION=v1

# ── Cloudflare R2 (ixtiyoriy; bo'sh bo'lsa yuklash ishlamaydi) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                 # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_ASSETS=looksave-assets

# Yuz va gavda suratlari uchun ALOHIDA, ommaviy bo'lmagan bucket (D-43).
#
# ⚠️ `Cache-Control: private` YETMAYDI. R2_BUCKET_ASSETS ning r2.dev manzili
# ochiq — havolani bilgan har kim suratni kalitsiz ocha oladi. Yagona
# ishonchli chegara — boshqa bucket, public access OFF.
#
# Bo'sh bo'lsa hammasi eskicha R2_BUCKET_ASSETS ga boradi va ilova
# ishlayveradi — lekin yuz suratlari OCHIQ qoladi. API ishga tushishda
# buni ogohlantirib aytadi.
#
# Sozlagandan keyin tekshiring:
#   npm run check:private-bucket --workspace=apps/api
R2_BUCKET_PRIVATE=

CDN_BASE_URL=https://cdn.looksave.app   # to'liq URL bo'lishi shart

# ── AI kiyintirish provayderi ──
#            naqshi va logosini saqlaydi. Sukut bo'yicha shu.
# `openai` — `gpt-image-1`. Umumiy rasm generatori: kiyimni nusxa
#            ko'chirmaydi, QAYTA CHIZADI — logo va naqsh o'zgarishi mumkin.
OPENAI_API_KEY=
