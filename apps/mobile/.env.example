# LookSave mobil — lokal ishlab chiqish uchun.
#
#   cp .env.example .env
#
# Expo bu faylni `npm start` da avtomatik o'qiydi va `EXPO_PUBLIC_*`
# o'zgaruvchilarini bundle ichiga yozadi (src/api/client.ts:23).
#
# ⚠️ Manzil qayerdan ishga tushirilganiga qarab FARQ qiladi:
#   iOS simulyator      → http://localhost:3000
#   Android emulyator   → http://10.0.2.2:3000   (10.0.2.2 = kompyuterning o'zi)
#   Haqiqiy telefon     → http://192.168.x.x:3000 (kompyuterning LAN IP'si;
#                          telefon bilan bir Wi-Fi tarmog'ida bo'lishi shart)
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Google Maps (ixtiyoriy) ──
# Bu kalitlar NATIVE konfiguratsiyaga yoziladi, ya'ni faqat build paytida
# o'qiladi (app.config.ts). Kalitsiz ilova ishlaydi, lekin xarita ekrani
# bo'sh kulrang maydon bo'lib qoladi — xato xabari chiqmaydi.
# Mobil kalitlar web panelinikidan ALOHIDA: "Maps SDK for Android" va
# "Maps SDK for iOS" yoqiladi, Places API YOQILMAYDI (K-05).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
