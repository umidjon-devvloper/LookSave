# Google Maps — do'konlar xaritasi uchun (docs/15-sayt-dizayn.md §4.5).
#
# ⚠️ IXTIYORIY: kalit berilmasa sayt buziladi deb o'ylamang — xarita
# ko'rsatilmaydi, do'konlar ro'yxati esa to'liq ishlayveradi.
#
# ⚠️ Bu ALOHIDA kalit. Mobil ilovadagi Android/iOS kalitlari web'da
# ishlamaydi va aksincha; store-panel kaliti bilan ham bo'lishmang —
# har domen o'z referrer cheklovi bilan yursin.
#
# Google Cloud Console:
#   1. APIs & Services → Enable → "Maps JavaScript API"
#      ❌ Places API YOQILMAYDI (00-README K-05)
#   2. Credentials → API key → HTTP referrer: sayt domeni
VITE_GOOGLE_MAPS_KEY=

# ── API va mehmon cheklovi (docs/15-sayt-dizayn.md S-4) ──

# SSR `loader`/`action` API ga TO'G'RIDAN-TO'G'RI boradi (brauzer emas).
API_URL=http://127.0.0.1:3000

# Sessiya cookie'sini imzolaydi. Prod'da bo'lmasa server ko'tarilmaydi.
#   openssl rand -base64 48
SESSION_SECRET=

# API bilan bir xil qiymat (`apps/api/.env`). Shu kalit bilan BFF mehmon
# IP'sini uzata oladi va cheklov MEHMON bo'yicha hisoblanadi. Bo'sh
# bo'lsa butun sayt daqiqasiga 30 ta so'rovlik bitta chelakni bo'lishadi.
#
# ⚠️ SERVER-SERVER. `VITE_` prefiksi YO'Q — aks holda Vite uni brauzer
# to'plamiga inline qiladi va har kim o'z cheklovini o'chirib qo'yadi.
#   openssl rand -base64 32
INTERNAL_SERVICE_KEY=

# Mehmon IP'si qaysi sarlavhadan olinadi (`src/lib/client-ip.server.ts`):
#   cloudflare — Cloudflare Workers: `CF-Connecting-IP` (13-sayt.md S-03)
#   1, 2, …    — oldida shuncha ishonchli proksi: `X-Forwarded-For`
#   bo'sh      — proksi yo'q (dev). IP olinmaydi
#
# ⚠️ Noto'g'ri qiymat cheklovni YO'QQA CHIQARADI: mijoz o'zi sarlavha
# yozib har so'rovda yangi chelak olardi. Bilmasangiz bo'sh qoldiring.
WEB_TRUST_PROXY=
