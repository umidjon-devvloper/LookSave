{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "node", "google.maps"],
    "noEmit": true,
    /*
     * React Router marshrut tiplarini `.react-router/types/` ga yozadi
     * (`+types/...` importlari shundan keladi). `rootDirs` ikkala
     * daraxtni bitta deb ko'rsatadi — shusiz `./+types/home` topilmaydi.
     */
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    ".react-router/types/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "react-router.config.ts"
  ]
}
