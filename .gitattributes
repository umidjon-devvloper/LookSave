# Barcha matn fayllari LF bilan (Windows/macOS/Linux aralash ishlaganda muhim)
* text=auto eol=lf

# Skriptlar va SQL — doim matn
*.sh          text eol=lf
*.sql         text eol=lf
*.md          text eol=lf
Caddyfile     text eol=lf

# ── git-lfs: 3D va og'ir binar fayllar (00-README §7) ──
*.blend       filter=lfs diff=lfs merge=lfs -text
*.glb         filter=lfs diff=lfs merge=lfs -text
*.gltf        filter=lfs diff=lfs merge=lfs -text
*.fbx         filter=lfs diff=lfs merge=lfs -text
*.ktx2        filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text

# Teksturalar (faqat assets-3d ichida — UI ikonkalari LFS'ga tushmasin)
assets-3d/**/*.png   filter=lfs diff=lfs merge=lfs -text
assets-3d/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
assets-3d/**/*.webp  filter=lfs diff=lfs merge=lfs -text

# Diff'da shovqin qilmasin
package-lock.json    -diff linguist-generated
