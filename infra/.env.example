# LookSave — muhit o'zgaruvchilari namunasi (docs/08-deployment.md §6)
#
#   cp .env.example .env && chmod 600 .env
#
# QOIDA: qiymatlarni qo'shtirnoq ichida yozing — skriptlar `source .env` qiladi,
# probel yoki `#` bo'lgan qiymat qo'shtirnoqsiz buziladi.
# Sirlar git'ga TUSHMAYDI. Bu fayl faqat namuna, qiymatlarsiz.

# ── Umumiy ──
NODE_ENV=production
PORT=3000
API_URL=https://api.looksave.app
API_DOMAIN=api.looksave.app
ACME_EMAIL=admin@looksave.app
GH_OWNER=umidjon-devvloper
API_TAG=latest
LOG_LEVEL=info

# ── Baza ──
# openssl rand -base64 32
POSTGRES_PASSWORD=""

# PostgreSQL sozlamalari — standart qiymatlar 8 GB RAM (CPX31) uchun.
# 16 GB (CPX41) ga o'tganda: 2GB / 6GB / 6G
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_CONNECTIONS=100
PG_MEM_LIMIT=3G
API_MEM_LIMIT=2G
REDIS_MAXMEMORY=512mb

# ── JWT ──
# openssl rand -base64 48 — access va refresh uchun ALOHIDA
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_ASSETS=looksave-assets
# ⚠️ SHAXSIY SURATLAR uchun ALOHIDA bucket (docs/12-tz.md D-43).
# Yuz va gavda suratlari shu yerga tushadi va OMMAVIY manzili BO'LMASLIGI kerak
# (Cloudflare: R2 -> bucket -> Settings -> Public access OFF).
# Bo'sh bo'lsa hammasi R2_BUCKET_ASSETS ga boradi va ochiq qoladi —
# API ishga tushishda buni ogohlantirish bilan aytadi.
R2_BUCKET_PRIVATE=looksave-private
R2_BUCKET_BACKUPS=looksave-backups
R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
CDN_BASE_URL=https://cdn.looksave.app

# ── SMS ──
SMS_PROVIDER=eskiz # eskiz | twilio
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM=4546
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── Telegram ──
TELEGRAM_BOT_TOKEN=""
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_USERNAME=LookSaveBot
# Bo'sh bo'lsa bot o'chirilgan deb hisoblanadi (dev muhitida qulay)
STORE_PANEL_URL=https://store.looksave.app

# ── LLM ──
GEMINI_API_KEY=""
GROQ_API_KEY=""
LLM_PRIMARY=gemini

# ── Google Maps (faqat geocoding, server tomonda) ──
GOOGLE_MAPS_SERVER_KEY=""

# ── Push ──
# Bo'sh bo'lsa push o'chirilgan deb hisoblanadi
EXPO_ACCESS_TOKEN=""

# ── Monitoring ──
SENTRY_DSN=""

# ── Biznes qoidalari ──
ORDER_EXPIRY_HOURS=24
MAX_OPEN_ORDERS=3
MAX_DAILY_ORDERS=5
DEFAULT_COMMISSION_RATE=0 # Faza 1-2 da 0 (K-12)
BLOCKLIST_ESCALATION_THRESHOLD=3

# ── CORS ──
CORS_ORIGINS=https://store.looksave.app,https://admin.looksave.app,https://looksave.app

# ── SSR sayti uchun xizmat kaliti (15-sayt-dizayn.md S-4) ──
#
# Sayt server tomonda chizilgani uchun API ga so'rov MEHMONDAN emas,
# VEB-SERVERDAN keladi. Kalitsiz butun sayt daqiqasiga 30 ta so'rovlik
# bitta chelakni bo'lishadi va sahifalar bo'sh ochiladi.
#
# Bu kalit bilan tanishtirgan chaqiruvchi mehmon IP'sini
# `X-LookSave-Client-Ip` sarlavhasida bera oladi.
#
# ⚠️ SERVER-SERVER. Brauzer bundle'iga TUSHMASIN — aks holda har kim
# o'z cheklovini o'chirib qo'yadi. `apps/web` da xuddi shu qiymat
# `INTERNAL_SERVICE_KEY` nomi bilan turadi.
#
# ⚠️ Bo'sh bo'lsa imkoniyat o'chiq — hech narsa buzilmaydi, cheklov
# eskicha `req.ip` bo'yicha ishlaydi.
#
#   openssl rand -base64 32
INTERNAL_SERVICE_KEY=
